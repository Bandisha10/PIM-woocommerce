# ==========================================
# Stockroom PIM Configuration
# ==========================================

# Database: Supabase PostgreSQL Connection String
# (Leave blank or commented out to use local SQLite)
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-database-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Live WooCommerce Store Credentials
# (Leave blank to use the built-in WooCommerce Sandbox Simulator)
WOO_URL=https://your-wordpress-store.com
WOO_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
